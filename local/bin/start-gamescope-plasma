#!/bin/bash

if [[ ! $(ps -e | grep -E -i "startplasmamobi") ]]; then
	echo "ERROR: plasma-mobile not running. exiting."
	exit 0
fi

CONFIG_DIR="$HOME/.config/gamescope-plasma-thor/"

# init folder if it doesn't exist
if [ ! -d "$CONFIG_DIR" ]; then
    mkdir "$CONFIG_DIR"
fi

# save existing rules if there are any
if [ -f "$HOME/.config/kwinrulesrc" ]; then 
    cp "$HOME/.config/kwinrulesrc" "$CONFIG_DIR/kwinrulesrc_backup"
else {
    touch "$HOME/.config/kwinrulesrc"
    touch "$CONFIG_DIR/kwinrulesrc_backup"
}
fi
PREVDOC="$CONFIG_DIR/kwinrulesrc_backup"
RULESRC="$HOME/.config/kwinrulesrc"

# rule creation
ORDER=""
newrule_start () {
    RULE_ID=$(uuidgen)
    count=$(kreadconfig6 --file kwinrulesrc --group General --key count --default 0 | sed 's/\“//' | sed 's/\”//')
    if [[ -z "$count" ]]; then
        count="0"
    fi
    new_count=$((count + 1))
    kwriteconfig6 --file kwinrulesrc --group General --key count "$new_count"
}

newrule_end () {
    if [[ $new_count -ne 1 ]]; then {
        ORDER+=","
        ORDER+="$RULE_ID"
    }
    else {
        ORDER="$RULE_ID"
    }
    fi
    kwriteconfig6 --file kwinrulesrc --group General --key rules "$ORDER"
}

newrule_start
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "BottomScreenLock"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screen "1" 
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key types "1"
newrule_end

newrule_start
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "GamescopeTopExplicit"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key above "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key aboverule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreen "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key layer "fullscreen"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key layerrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key title "Steam Big Picture Mode"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key titlematch "1"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclass "gamescope"
newrule_end

newrule_start
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "melonDS1"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key above "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key aboverule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key maximizehoriz "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key maximizehorizrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key maximizevert "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key maximizevertrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key title "\\[w1\\]"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key titlematch "3"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclass "melonDS net.kuribo64.melonDS"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclasscomplete "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclassmatch "1"
newrule_end

newrule_start
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "melonDS2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key aboverule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key maximizehoriz "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key maximizehorizrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key maximizevert "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key maximizevertrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screen "1"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key title "\\[w2\\]"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key titlematch "3"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclass "melonDS net.kuribo64.melonDS"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclassmatch "1"
newrule_end

newrule_start
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "AzaharTop"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key above "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key aboverule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key decorationpolicy "none"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key decorationpolicyrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreen "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key title "Primary Window"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key titlematch "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key types "1"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclass "org.azahar_emu.Azahar"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclassmatch "1"
newrule_end

newrule_start
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "AzaharBottom"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key above "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key aboverule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key decorationpolicy "none"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key decorationpolicyrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreen "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screen "1"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key title "Secondary Window"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key titlematch "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key types "1"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclass "org.azahar_emu.Azahar"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclassmatch "1"
newrule_end

newrule_start
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "Cemu1"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key above "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key aboverule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key decorationpolicy "server"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key decorationpolicyrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreen "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key title "Cemu"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key titlematch "3"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclass "info.cemu.Cemu"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclassmatch "1"
newrule_end

newrule_start
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key Description "Cemu2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key above "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key aboverule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key decorationpolicy "server"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key decorationpolicyrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreen "true"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key fullscreenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screen "1"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key screenrule "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key title "GamePad View"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key titlematch "2"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclass "info.cemu.Cemu"
kwriteconfig6 --file kwinrulesrc --group "$RULE_ID" --key wmclassmatch "1"
newrule_end

qdbus6 org.kde.KWin /KWin reconfigure

# file to refer to for other systems to check if this program is active
touch $CONFIG_DIR/.active

# on installer, sudoers files added exceptions for these mounts and unmounts
sudo /usr/bin/mount --bind /home/deck/.local/bin/steam-shutdown /usr/bin/steamos-session-select

# explicitly adding ~/.local/bin to PATH so that steam picks up the DS programs
export PATH="$HOME/.local/bin:$PATH"

# init gamescope with an explicit wayland display for window management
GAMESCOPE_WAYLAND_DISPLAY=steam gamescope -W 1920 -w 1920 -H 1080 -h 1080 -r 120 -ef --force-grab-cursor --mangoapp -- steam -gamepadui -steamos3 -steampal -steamdeck &
GAMESCOPE_PID=$!

wait $GAMESCOPE_PID

# clean up
rm "$CONFIG_DIR/.active"
sudo /usr/bin/umount /usr/bin/steamos-session-select
cp "$PREVDOC" "$RULESRC"
exit 0
